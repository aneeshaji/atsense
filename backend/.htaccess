<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect all traffic into the Laravel public folder AND re-append /api prefix
    # so Laravel's router (which sees the base /api) finds the routes in api.php
    RewriteCond %{REQUEST_URI} !^/api/public/
    RewriteRule ^(.*)$ public/api/$1 [L]
</IfModule>
