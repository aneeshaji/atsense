##############################################################
# ATSense – Production .env (cPanel / Shared Hosting)
# Place this file at: /atsense.online/api/.env via File Manager
# DO NOT commit this file to Git — it is in .gitignore
##############################################################

APP_NAME=ATSense
APP_ENV=production
APP_KEY=base64:PASTE_YOUR_LOCAL_KEY_HERE
APP_DEBUG=false
APP_URL=https://atsense.online/api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_cpanel_db_name
DB_USERNAME=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password

# ── Session & Cache (file-based for shared hosting) ───────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=atsense.online

CACHE_STORE=file

QUEUE_CONNECTION=sync

# ── Mail (optional — configure if needed) ─────────────────
MAIL_MAILER=smtp
MAIL_HOST=mail.atsense.online
MAIL_PORT=465
MAIL_USERNAME=no-reply@atsense.online
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@atsense.online"
MAIL_FROM_NAME="ATSense"

# ── CORS ──────────────────────────────────────────────────
# The frontend origin that is allowed to call the API
FRONTEND_URL=https://atsense.online
