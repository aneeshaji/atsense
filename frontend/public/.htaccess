<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # 0. Force HTTPS Redirect
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 1. Pass through real static files (JS, CSS, images, fonts)
  #    but NOT /api files — those must be routed to PHP below
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/api
  RewriteRule ^ - [L]

  # 2. Route ALL /api/* requests directly to Laravel entry point
  #    LiteSpeed does NOT cascade into subdirectory .htaccess after [L],
  #    so we must handle this here in the root .htaccess explicitly.
  RewriteCond %{REQUEST_URI} ^/api
  RewriteRule ^ /api/index.php [L,QSA]

  # 3. All other routes → React SPA (handles /blog, /builder, etc.)
  RewriteRule ^ /index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # 1. HSTS (Strict-Transport-Security) - 2 years
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    
    # 2. X-Frame-Options (Anti-Clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # 3. X-Content-Type-Options (Anti-MIME-Sniffing)
    Header always set X-Content-Type-Options "nosniff"
    
    # 4. Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # 5. X-XSS-Protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # 6. Content Security Policy (CSP)
    # Allows self, Google Fonts, and Google Tag Manager
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://api.producthunt.com https://api.producthunt.com; connect-src 'self' https://www.googletagmanager.com https://www.google-analytics.com;"
    
    # 7. Permissions Policy
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>


